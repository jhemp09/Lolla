# Copy to .env.local for local dev, or set these as environment variables in
# your deploy host (e.g. Vercel Project Settings > Environment Variables).
# These are baked into the build at build time — end users never see or enter
# them; they just get an online/offline toggle.
# VITE_SUPABASE_ANON_KEY: from Settings > API Keys. Use the "Publishable key"
# (sb_publishable_...) if your project has one, otherwise the legacy "anon
# public" key (eyJ...) — either works, same public/RLS-protected role.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: powers the "Your Festival, As Told By AI" recap button on the Fest Recap
# tab. Server-side only (no VITE_ prefix) — never bundled into the client, only read by
# the /api/recap serverless function. Without it, that button just shows a friendly error.
# From https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Optional, defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
